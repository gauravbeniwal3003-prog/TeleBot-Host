      "content": "import logging\r\nfrom telegram import Update\r\nfrom telegram.ext import Application, MessageHandler, filters, ContextTypes\r\n\r\n# Enable logging\r\nlogging.basicConfig(\r\n    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\r\n    level=logging.INFO\r\n)\r\nlogger = logging.getLogger(__name__)\r\n\r\n# ========== HARD CODE YOUR BOT TOKEN HERE ==========\r\nBOT_TOKEN = \"8437341863:AAGomHlGAfHvNR9w0I9AK82rfL-IVDGWkaI\"  # Replace with your actual bot token\r\n# ===================================================\r\n\r\nasync def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):\r\n    \"\"\"Handle every incoming message and reply with 'yes Bosss...'\"\"\"\r\n    try:\r\n        # Get the user's message\r\n        user_message = update.message.text if update.message.text else \"non-text message\"\r\n        user_name = update.message.from_user.first_name\r\n        \r\n        # Log the incoming message\r\n        logger.info(f\"Message from {user_name}: {user_message}\")\r\n        \r\n        # Reply with \"yes Bosss...\"\r\n        await update.message.reply_text(\"yes Bosss...\")\r\n        \r\n    except Exception as e:\r\n        logger.error(f\"Error handling message: {e}\")\r\n        # Try to send error message to user\r\n        try:\r\n            await update.message.reply_text(\"Sorry, something went wrong! 😅\")\r\n        except:\r\n            pass\r\n\r\nasync def start(update: Update, context: ContextTypes.DEFAULT_TYPE):\r\n    \"\"\"Send a welcome message when /start command is issued\"\"\"\r\n    welcome_text = (\r\n        \"🤖 *Bot Activated!*\\n\\n\"\r\n        \"I will reply with *'yes Bosss...'* to every message you send!\\n\"\r\n        \"Try sending me anything 😎\"\r\n    )\r\n    await update.message.reply_text(welcome_text, parse_mode='Markdown')\r\n\r\nasync def error_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):\r\n    \"\"\"Log errors caused by updates\"\"\"\r\n    logger.error(f\"Update {update} caused error {context.error}\")\r\n\r\ndef main():\r\n    \"\"\"Start the bot\"\"\"\r\n    # Create the Application\r\n    app = Application.builder().token(BOT_TOKEN).build()\r\n    \r\n    # Register handlers\r\n    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))\r\n    app.add_handler(MessageHandler(filters.COMMAND, handle_message))  # Also reply to commands\r\n    app.add_handler(MessageHandler(filters.ALL & ~filters.TEXT, handle_message))  # Handle non-text messages\r\n    \r\n    # Add command handler for /start\r\n    from telegram.ext import CommandHandler\r\n    app.add_handler(CommandHandler(\"start\", start))\r\n    \r\n    # Register error handler\r\n    app.add_error_handler(error_handler)\r\n    \r\n    # Start the bot\r\n    print(\"🤖 Bot is running... Press Ctrl+C to stop\")\r\n    print(f\"Bot token: {BOT_TOKEN[:10]}... (hidden for security)\")\r\n    \r\n    # Run the bot until you press Ctrl+C\r\n    app.run_polling(allowed_updates=Update.ALL_TYPES)\r\n\r\nif __name__ == '__main__':\r\n    main()",
